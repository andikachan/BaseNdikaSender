# ==============================================================================
# KONFIGURASI SERVER REST API & WEBSOCKET BOT WHATSAPP
# ==============================================================================

# Port HTTP server REST API & WebSocket (Default: 25566)
PORT=25566

# API Key untuk mengamankan akses ke semua endpoint dan WebSocket
# Masukkan API Key ini pada aplikasi Android Flutter
API_KEY=ndika_secret_key_2026

# Konfigurasi CORS (* untuk development, atau domain spesifik untuk production)
CORS_ORIGIN=*

# Path ke folder sesi WhatsApp Baileys (Multi-file auth)
SESSION_DIR=./session

# Mode Pairing ('terminal' untuk prompt konsol, 'api' untuk kontrol penuh via Android Dashboard)
PAIRING_MODE=api
